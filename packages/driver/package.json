{
  "name": "@hand-tracker/driver",
  "version": "0.1.0",
  "description": "Desktop mouse driver for Hand Tracker using RobotJS",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "prepare:cjs": "node scripts/prepare-cjs.mjs",
    "build": "npm run build:esm && npm run build:cjs && npm run prepare:cjs"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "dependencies": {
    "@hand-tracker/core": "^0.1.0",
    "robotjs": "^0.9.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
